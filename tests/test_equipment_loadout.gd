extends SceneTree


func _init() -> void:
	var state := preload("res://scripts/core/game_state.gd").new()
	root.add_child(state)
	state.get_idle_disciples()
	var first_id := int(state.disciples[0]["id"])
	var second_id := int(state.disciples[1]["id"])
	var weapon_a := state.create_equipment_instance(&"initiate_weapon", &"common")
	var weapon_b := state.create_equipment_instance(&"initiate_weapon", &"rare")
	var armor := state.create_equipment_instance(&"cloud_robe", &"common")
	var ring := state.create_equipment_instance(&"spirit_ring", &"epic")
	var base := state.get_disciple_battle_stats(first_id)
	assert(state.equip_item(first_id, weapon_a))
	assert(state.equip_item(first_id, armor))
	assert(state.equip_item(first_id, ring))
	var equipped := state.get_disciple_battle_stats(first_id)
	assert(is_equal_approx(float(equipped["attack"]), float(base["attack"]) + 8.5))
	assert(is_equal_approx(float(equipped["hp"]), float(base["hp"]) + 42.5))
	assert(is_equal_approx(float(equipped["defense"]), float(base["defense"]) + 4.25))
	assert(state.get_equipment_owner(weapon_a) == first_id)
	assert(not state.equip_item(second_id, weapon_a))
	assert(state.equip_item(first_id, weapon_b))
	assert(state.get_equipment_owner(weapon_a) == 0)
	assert(state.get_equipment_owner(weapon_b) == first_id)
	assert(state.unequip_item(first_id, &"weapon"))
	assert(state.get_equipment_owner(weapon_b) == 0)

	assert(state.set_disciple_job(first_id, &"combat"))
	assert(state.start_auto_battle(1))
	assert(state.equip_item(first_id, weapon_a))
	assert(not state.battle_running and not state.auto_battle_enabled)
	assert("更换装备" in state.battle_message)
	var snapshot := state.export_save_data()
	var restored := preload("res://scripts/core/game_state.gd").new()
	root.add_child(restored)
	assert(restored.import_save_data(snapshot))
	assert(restored.get_disciple(first_id)["equipment"] == state.get_disciple(first_id)["equipment"])
	assert(restored.get_disciple_battle_stats(first_id) == state.get_disciple_battle_stats(first_id))
	print("PASS: equip, replace, unequip, unique ownership, battle stop, and stat linkage")
	quit()
