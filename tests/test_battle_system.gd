extends SceneTree


func _init() -> void:
	var state := preload("res://scripts/core/game_state.gd").new()
	root.add_child(state)
	state.get_idle_disciples()
	var first_id := int(state.disciples[0]["id"])
	assert(state.set_disciple_job(first_id, &"forest"))
	assert(state.get_assignment(&"forest") == 1)
	assert(state.set_disciple_job(first_id, &"combat"))
	assert(state.get_assignment(&"forest") == 0)
	assert(state.battle_party == [first_id])
	assert(StringName(state.get_disciple(first_id)["job"]) == &"combat")
	var stats := state.get_battle_party_stats()
	var member_stats := state.get_disciple_battle_stats(first_id)
	assert(is_equal_approx(float(stats["hp"]), float(member_stats["hp"])))
	assert(is_equal_approx(float(stats["attack"]), float(member_stats["attack"])))
	assert(is_equal_approx(float(stats["defense"]), float(member_stats["defense"])))
	assert(not state.select_battle_stage(2))
	var wood_before := state.get_resource_amount(&"wood")
	var food_before := state.get_resource_amount(&"food")
	assert(state.start_auto_battle(1))
	assert(state.process_battle(20.0))
	assert(state.battle_victories == 1)
	assert(state.highest_cleared_stage == 1)
	assert(state.highest_unlocked_stage == 2)
	assert(state.get_resource_amount(&"wood") == wood_before + 1)
	assert(state.get_resource_amount(&"food") == food_before + 1)
	assert(state.auto_battle_enabled)
	assert(not state.battle_running)
	state.process_battle(state.BATTLE_RESTART_DELAY)
	assert(state.battle_running)

	var saved := state.export_save_data()
	var restored := preload("res://scripts/core/game_state.gd").new()
	root.add_child(restored)
	assert(restored.import_save_data(saved))
	assert(restored.battle_party == [first_id])
	assert(restored.highest_unlocked_stage == 2)
	assert(restored.battle_victories == 1)
	assert(restored.battle_running)
	assert(restored.set_disciple_job(first_id, &"idle"))
	assert(restored.battle_party.is_empty())
	assert(not restored.auto_battle_enabled)
	print("PASS: party formation, combat stats, auto battle, stage unlocks, rewards, and persistence")
	quit()
