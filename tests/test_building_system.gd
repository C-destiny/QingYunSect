extends SceneTree


func _init() -> void:
	var state := preload("res://scripts/core/game_state.gd").new()
	root.add_child(state)
	assert(BuildingCatalog.get_cost_text(&"lumber_yard") == "木材30、灵石15")
	assert(not state.is_cell_occupied(Vector2i(0, 0)))
	assert(state.is_cell_occupied(Vector2i(4, 3)))
	assert(state.start_construction(&"lumber_yard", Vector2i(0, 0)))
	assert(state.get_resource_amount(&"wood") == 90)
	assert(state.get_resource_amount(&"spirit_stone") == 65)
	assert(state.is_cell_occupied(Vector2i(0, 0)))
	assert(not state.start_construction(&"spirit_field", Vector2i(0, 0)))
	assert(not bool(state.buildings[0]["completed"]))
	assert(is_equal_approx(state.get_production_multiplier(&"wood"), 1.0))
	state.process_construction(5.1)
	assert(bool(state.buildings[0]["completed"]))
	assert(is_equal_approx(state.get_production_multiplier(&"wood"), 1.25))
	assert(is_equal_approx(state.get_production_multiplier(&"food"), 1.0))
	assert(state.assign_disciple(&"forest"))
	var wood_before := state.get_resource_amount(&"wood")
	assert(state.process_production(&"forest", &"wood", 12.0, 4.0) == 1)
	assert(state.get_resource_amount(&"wood") == wood_before + 1)
	state.resources["wood"] = 100
	state.resources["spirit_stone"] = 100
	assert(state.start_construction(&"disciple_quarters", Vector2i(1, 0)))
	assert(state.get_disciple_capacity() == 3)
	state.process_construction(6.1)
	assert(state.get_disciple_capacity() == 5)
	var saved := state.export_save_data()
	var restored := preload("res://scripts/core/game_state.gd").new()
	root.add_child(restored)
	assert(restored.import_save_data(saved))
	assert(restored.buildings.size() == 2)
	assert(bool(restored.buildings[0]["completed"]))
	assert(bool(restored.buildings[1]["completed"]))
	assert(is_equal_approx(restored.get_production_multiplier(&"wood"), 1.25))
	assert(restored.get_disciple_capacity() == 5)
	assert(restored.is_cell_occupied(Vector2i(0, 0)))
	print("PASS: building placement, cost, construction, and persistence")
	quit()

